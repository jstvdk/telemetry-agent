# camera-in-a-box: feed the event builder with synthetic UDP waveform packets. Named lab-*, not
# sstcam-*, so the camera collector never mistakes lab infrastructure for camera software (P-20).
[Unit]
Description=Lab: Event Builder mock data source (stands in for camera hardware)
PartOf=sstcam.target
Requisite=sstcam-session.service
After=sstcam-eventbuilder.service
BindsTo=sstcam-eventbuilder.service

[Service]
Type=simple
Environment=TQDM_DISABLE=1
WorkingDirectory=%h
ExecStartPre=/bin/sleep 5
ExecStart=%h/miniforge3/envs/sstcam/bin/sstcam eventbuilder mock start empty
Restart=on-failure
RestartSec=10

[Install]
WantedBy=sstcam.target
