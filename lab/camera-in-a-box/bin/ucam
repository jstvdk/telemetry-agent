#!/bin/bash
# Run a command as the camera user inside its systemd user session, e.g.
#   docker exec cam-01 ucam systemctl --user status sstcam.target
#   docker exec cam-01 ucam journalctl --user -u sstcam-chiller -f
exec sudo -u sstcam env XDG_RUNTIME_DIR=/run/user/1000 \
  DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus \
  PATH=/opt/sstcam/venv/bin:/usr/bin:/bin \
  SSTCAM_CONFIG_SOURCE=LOCAL_DB SSTCAM_CONFIG_DIR=/etc/sstcam SSTCAM_CONFIG_DATA_PATH=/opt/sstcam/data \
  SSTCAM_SERVER_ID=0 SSTCAM_OUTPUT_PATH=/data/SSTCAM SSTCAM_TERMINAL_COLOUR_DISABLE=1 \
  "$@"
